@startuml ArduSim2_Component_Diagram

title ArduSim2 - Diagrama de Componentes

top to bottom direction

skinparam componentStyle rectangle
skinparam nodesep 25
skinparam ranksep 45
skinparam defaultFontName Arial
skinparam ArrowColor #555555
skinparam ArrowThickness 1.3
skinparam shadowing false

skinparam component {
    BackgroundColor<<broker>>     #D6EAF8
    BorderColor<<broker>>         #2980B9
    BackgroundColor<<algorithm>>  #D5F5E3
    BorderColor<<algorithm>>      #27AE60
    BackgroundColor<<mixer>>      #FEF9E7
    BorderColor<<mixer>>          #F39C12
    BackgroundColor<<controller>> #FDEDEC
    BorderColor<<controller>>     #E74C3C
    BackgroundColor<<comms>>      #F5EEF8
    BorderColor<<comms>>          #8E44AD
    BackgroundColor<<netsim>>     #EAECEE
    BorderColor<<netsim>>         #5D6D7E
    BackgroundColor<<logger>>     #F5F5F5
    BorderColor<<logger>>         #95A5A6
}

skinparam package {
    BackgroundColor #FBFCFC
    BorderColor #BDC3C7
}

' ================================================================
' ACTORES
' ================================================================

actor "GUI / Operador" as GUI

' ================================================================
' INSTANCIA POR UAV
' ================================================================

package "Instancia UAV  [x N drones]" {

    component [Communication Module\n(Broker pub/sub  UDP :3400)] as Broker <<broker>>

    together {
        component [Mission Algorithm] as AlgoMission <<algorithm>>
        component [Follow Me Algorithm\n(master / slave)] as AlgoFollowMe <<algorithm>>
    }

    component [Mixer] as Mixer <<mixer>>

    component [UAV Controller\n(ArduCopter 4.5.3)] as UAVCtrl <<controller>>

    component [External Comms] as ExtComms <<comms>>
}

' ================================================================
' HARDWARE / SITL
' ================================================================

database "ArduCopter SITL\n(o hardware real)" as SITL

' ================================================================
' INFRAESTRUCTURA COMPARTIDA
' ================================================================

package "Infraestructura compartida  [global]" {

    component [NetSim Gateway] as NetSimGW <<netsim>>

    together {
        component [NetSim Node\n(radio CSMA/CA)] as NetSim <<netsim>>
        component [Logger\n(UDP :5000)] as Logger <<logger>>
    }
}

' ================================================================
' RELACIONES
' ================================================================

' Nivel 0 -> 1
GUI -down-> Broker : "comandos (algo/mission, algo/followme)"

' Nivel 1 <-> 2  (Broker <-> Algoritmos)
Broker -down-> AlgoMission   : "uav/telemetry\nalgo/mission"
AlgoMission -up-> Broker     : "uav/suggestions\nexternal/messages"

Broker -down-> AlgoFollowMe  : "uav/telemetry\nalgo/followme"
AlgoFollowMe -up-> Broker    : "uav/suggestions\nexternal/messages"

' Nivel 1 <-> 3  (Broker <-> Mixer)
Broker -down-> Mixer : "uav/suggestions"
Mixer -up-> Broker   : "uav/telemetry\nglobal/commands"

' Nivel 3 <-> 4  (Mixer <-> UAV Controller, UDP directo)
Mixer -down-> UAVCtrl  : "comandos JSON  (UDP :9876)"
UAVCtrl -up-> Mixer    : "telemetria raw  (UDP :3500)"

' Nivel 4 <-> SITL
UAVCtrl -down-> SITL : "MAVLink (TCP / Serial)"
SITL -up-> UAVCtrl   : "MAVLink acks + datos"

' Nivel 1 <-> 5  (Broker <-> External Comms)
Broker -down-> ExtComms  : "uav/telemetry\nexternal/messages\nuav/logs"
ExtComms -up-> Broker    : "mensajes swarm recibidos"

' Nivel 5 <-> 6  (External Comms <-> NetSim Gateway)
ExtComms -down-> NetSimGW : "UDP :3000  telemetry / broadcast"
NetSimGW -up-> ExtComms   : "UDP :3000  deliver"

' Nivel 6 <-> 7  (NetSim Gateway <-> NetSim Node)
NetSimGW -down-> NetSim : "UDP :3001\nuav_telemetry, uav_broadcast"
NetSim -up-> NetSimGW   : "UDP :3001\ndeliver, snapshot"

' Logs
ExtComms -right-> Logger  : "UDP :5000"
NetSimGW -down-> Logger   : "UDP :5000"
NetSim -right-> Logger    : "UDP :5000"

@enduml

@startuml ArduSim2_Deployment_Local

title ArduSim2 - Despliegue Local (Docker Compose)\nS swarms x N UAVs por swarm

top to bottom direction

skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 40

<style>
root {
  FontName Arial
  FontSize 11
}
title {
  FontSize 13
  FontStyle bold
}
node {
  BackgroundColor #EBF5FB
  BorderColor     #2980B9
  BorderThickness 1.5
  FontColor       #1A5276
}
artifact {
  BackgroundColor #FDFEFE
  BorderColor     #95A5A6
  FontColor       #444444
  FontSize        10
}
component {
  BackgroundColor #D5F5E3
  BorderColor     #27AE60
  FontColor       #1D6A39
}
rectangle {
  BackgroundColor #FDFEFE
  BorderColor     #BDC3C7
  BorderThickness 1
  FontColor       #555555
  FontSize        10
  FontStyle       italic
}
arrow {
  LineColor       #444444
  LineThickness   1.2
  FontColor       #555555
  FontSize        9
}
</style>

node "PC de Desarrollo  (Linux / macOS / WSL2)" as DevPC {

    ' -- COLUMNA IZQUIERDA: Infraestructura --
    rectangle "Infraestructura compartida  [red air 10.9.0.0/24 - 1 global]" as Infra {

        component "GUI" as GUI

        node "netsim_gateway\n:3000 UAVs  :3001 NetSim  :3002 UI" as GW {
            artifact "netsim_gateway:latest" as GWImg
        }

        node "netsim_1 ... netsim_K  [env NODE_ID]" as NS {
            artifact "netsim:latest (x K)" as NSImg
        }

        node "logger  [:5000 UDP  :8080 TCP]" as Log {
            artifact "logger:latest" as LogImg
        }
        
        GUI -[hidden]down- GW
        GW -[hidden]down- NS
        NS -[hidden]down- Log
    }

    ' -- COLUMNA DERECHA: Stack UAV --
    rectangle "Stack por UAV  [red swarm_net_[S]_uav_[N] - replicado S x N veces]" as UAVStack {

        node "communication_module  [:3400]" as Broker {
            artifact "communication_module:latest" as BrokerImg
        }

        together {
            node "external_comms\n[red air + swarm_net]" as Ext {
                artifact "external_comms:latest" as ExtImg
            }
            node "algorithm_1 ... A" as Algo {
                artifact "algorithm:latest (x A)" as AlgoImg
            }
            node "mixer" as Mixer {
                artifact "mixer:latest" as MixerImg
            }
        }

        node "uav_controller + ArduCopter SITL\n[:9876 cmd  :3500 telem  SITL :5760]" as Ctrl {
            artifact "uav_controller_arducopter4_5_3:latest" as CtrlImg
        }

        Broker -[hidden]down- Ext
        Ext -[hidden]right- Algo
        Algo -[hidden]right- Mixer
        Mixer -[hidden]down- Ctrl
    }

    Infra -[hidden]right- UAVStack
}

' ======================================================
' CONEXIONES
' ======================================================

GUI -down-> GW  : "subscribe :3002"
GW  -down-> NS  : ":3001"
GW  -down-> Log : ":5000"
NS  -down-> Log : ":5000"

Broker -down-> Ext   : ":3400"
Broker -down-> Algo  : ":3400"
Broker -down-> Mixer : ":3400"
Mixer  -down-> Ctrl  : ":9876 / :3500"

Ext -left-> GW  : ":3000"
Ext -left-> Log : ":5000"

@enduml

{
  "service_id": "mission",
  "title": "Mission",
  "type": "object",
  "required": [
    "mission_file",
    "broker_ip",
    "broker_port",
    "subscription_topic",
    "publish_topic",
    "telemetry_topic",
    "distance_to_waypoint_reached",
    "minimum_waypoint_relative_altitude",
    "waypoints_relative_altitude",
    "external_messages_topic"
  ],
  "properties": {
    "mission_file": {
      "type": "string",
      "format": "kml",
      "contentMediaType": "application/vnd.google-earth.kml+xml",
      "title": "Mission Route (.kml)",
      "description": "El archivo KML que contiene las rutas de vuelo para la misión."
    },
    "broker_ip": {
      "type": "string",
      "description": "La IP del Communication Module (broker de mensajes).",
      "default": "communication_module"
    },
    "broker_port": {
      "type": "integer",
      "description": "El puerto UDP del Communication Module (por defecto 3400).",
      "default": 3400
    },
    "subscription_topic": {
      "type": "string",
      "description": "El canal donde el algoritmo escucha comandos (ej. algo/mission).",
      "default": "algo/mission"
    },
    "publish_topic": {
      "type": "string",
      "description": "El canal donde el algoritmo publica órdenes al dron (ej. uav/1/cmd).",
      "default": "uav/suggestions"
    },
    "telemetry_topic": {
      "type": "string",
      "description": "El canal donde el algoritmo recibe telemetría del dron (ej. uav/1/telemetry).",
      "default": "uav/telemetry"
    },
    "distance_to_waypoint_reached": {
      "type": "number",
      "title": "Distance to Waypoint Reached (cm)",
      "default": 200.0
    },
    "minimum_waypoint_relative_altitude": {
      "type": "number",
      "title": "Minimum Waypoint Relative Altitude (m)",
      "default": 5.0
    },
    "external_messages_topic": {
      "type": "string",
      "description": "El canal donde se mandan mensajes al finalizar la misión.",
      "default": "external/messages"
    },
    "mission_end": {
      "type": "string",
      "title": "Mission End",
      "enum": ["unmodified", "land", "rtl"],
      "default": "unmodified"
    },
    "final_altitude_for_rtl": {
      "type": "number",
      "title": "Final Altitude for RTL (m)",
      "default": 5.0
    },
    "input_mission_delay": {
      "type": "number",
      "title": "Input Mission Delay (s)",
      "default": 0.0
    },
    "override_include_altitude_values": {
      "type": "boolean",
      "title": "Override Include Altitude Values",
      "default": false
    },
    "waypoints_relative_altitude": {
      "type": "number",
      "title": "Waypoints Relative Altitude (m)",
      "default": 5.0
    },
    "override_include_yaw_values": {
      "type": "boolean",
      "title": "Override Include Yaw Values",
      "default": false
    },
    "yaw_value": {
      "type": "string",
      "title": "Yaw Value",
      "enum": [
        "Fixed",
        "Face next Waypoint",
        "Face next Waypoint except RTL",
        "Face along GPS course"
      ],
      "default": "Face next Waypoint except RTL"
    },
    "relative_movement": {
      "type": "boolean",
      "title": "Relative Movement",
      "default": false
    },
    "logs_topic": {
      "type": "string",
      "default": "uav/logs"
    }
  }
}

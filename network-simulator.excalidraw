      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "9zK_Mjn70lcGcCPSUho4o"
      ],
      "frameId": null,
      "index": "b3n",
      "roundness": null,
      "seed": 1798788657,
      "version": 272,
      "versionNonce": 1538817865,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780755025002,
      "link": null,
      "locked": true,
      "text": "YAML",
